    {
      "id": "dependency-drift",
      "strength": 2,
      "axes": {
        "fault-injection": ["none"],
        "process-state": ["cold-start"]
      },
      "invariants": ["Go and PlatformIO toolchains are pinned or explicitly compatibility-tested.", "Security scan failure blocks release hardening."]
    },
    {
      "id": "artifact-integrity",
      "strength": 2,
      "axes": {
        "transport": ["cdc-v2", "hid-v3"],
        "process-state": ["cold-start"]
      },
      "invariants": ["Both firmware artifacts meet size budgets and have SHA256.", "Release artifacts map to one exact commit."]
